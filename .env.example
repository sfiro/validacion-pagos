# OPCIONAL. Lo normal es conectar la cuenta desde el panel (⚙︎ Configuración).
# Úsalo solo para ajustes avanzados: cópialo como .env.
# Lo que se guarda desde el panel tiene prioridad sobre este archivo.


# Cuenta de Gmail donde llegan las notificaciones
GMAIL_USUARIO=tucorreo@gmail.com
# Contraseña de APLICACIÓN (16 letras), NO tu contraseña normal.
# Créala en https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos)
GMAIL_CLAVE_APP=xxxx xxxx xxxx xxxx

# Carpeta a revisar. Si tienes filtros que archivan estos correos, usa "[Gmail]/Todos"
IMAP_CARPETA=INBOX

# Dominios de remitentes confiables (separados por coma)
DOMINIOS_BANCOLOMBIA=bancolombia.com.co,notificacionesbancolombia.com,bancolombia.com
DOMINIOS_BOLD=bold.co

# true = los correos sin firma válida del banco se marcan "NO VERIFICADO" (recomendado)
# Ponlo en false SOLO si las notificaciones te llegan reenviadas desde otro correo.
REQUERIR_AUTENTICACION=true

SEGUNDOS_ENTRE_REVISIONES=30
# La primera vez, cuántos días hacia atrás importar
DIAS_INICIALES=2

PUERTO=8080
# PIN para abrir el panel (recomendado si clientes usan el mismo WiFi). Vacío = sin PIN.
PIN_ACCESO=
